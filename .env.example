# St Annes Old Links member credentials
MEMBER_ID=
MEMBER_PIN=

# Your name as it appears on the tee sheet (case-insensitive partial match)
PLAYER_NAME=

# Alert if your tee time is at or after this time (HH:MM, 24-hour)
CUTOFF_TIME=10:00

# Active hours window — scraper skips runs outside this range (HH:MM, 24-hour)
ACTIVE_START=06:00
ACTIVE_END=23:00

# SMTP email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Email address to receive alerts
ALERT_TO=you@gmail.com

# Telegram notifications (optional — set both to enable)
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
